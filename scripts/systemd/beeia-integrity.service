[Unit]
Description=BeeIA host file integrity check

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/beeia-security/host_integrity.py check
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/beeia-integrity
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beeia-integrity
