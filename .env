# BeeIA - Configuração principal do ambiente

###############################################
# Credenciais de Acesso Web (Interface Nginx) #
###############################################
# Use 'htpasswd -n -b "usuario" "senha" | base64 -w0' para gerar
# Exemplo: htpasswd -n -b "admin" "senha123" | base64 -w0
WEB_USER=

##################################
# Configurações de Comportamento #
##################################

# Blackhole - bloqueia scanners conhecidos (reduz tráfego)
# DISABLED: padrão, recebe tudo
# ENABLED: ativa nullrouting de IPs de scanners conhecidos
TPOT_BLACKHOLE=DISABLED

# Persistência de logs
# on: mantém logs por N dias (padrão)
# off: sem persistência (útil para testes)
TPOT_PERSISTENCE=on

# Dias de retenção dos logs (1-999)
TPOT_PERSISTENCE_CYCLES=30

# AttackMap - exibir eventos no console
# ENABLED: padrão
# DISABLED: desativa
TPOT_ATTACKMAP_TEXT=ENABLED

# Fuso horário do AttackMap
# UTC: padrão
# Exemplo: America/Sao_Paulo
TPOT_ATTACKMAP_TEXT_TIMEZONE=America/Sao_Paulo

###################################################################################
# CONFIGURAÇÕES INTERNAS - NÃO ALTERAR SALVO SE SOUBER O QUE ESTÁ FAZENDO        #
###################################################################################

TPOT_DOCKER_SOCK=/var/run/docker.sock
TPOT_DOCKER_ENV=./.env
TPOT_DOCKER_COMPOSE=./docker-compose.yml
TPOT_TYPE=HIVE

# Registro de imagens Docker
# ghcr.io/telekom-security: GitHub Container Registry (padrão)
# dtagdevsec: DockerHub
TPOT_REPO=ghcr.io/telekom-security
TPOT_VERSION=24.04.1

# Política de download das imagens
# always: sempre baixa a imagem mais recente
# missing: só baixa se não existir localmente
# never: usa apenas imagens já baixadas
TPOT_PULL_POLICY=always

# Caminho onde os dados/logs serão salvos
TPOT_DATA_PATH=./data

# Sistema operacional host (linux, mac, win)
TPOT_OSTYPE=linux
